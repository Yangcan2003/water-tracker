{
  "name": "health-tracker",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "description": "每日健康追踪 — 饮水/药物/补剂记录 PWA",
  "scripts": {
    "ai:setup": "node scripts/setup-ai.mjs",
    "ai:dev": "wrangler dev --config wrangler.ai.jsonc",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "ios:add": "node scripts/build.mjs && cap add ios",
    "ios:sync": "node scripts/build.mjs && cap sync ios",
    "ios:open": "node scripts/build.mjs && cap sync ios && cap open ios",
    "ios:run": "node scripts/build.mjs && cap sync ios && cap run ios",
    "ai:probe-plus": "node scripts/probe-chatgpt.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "chart.js": "4.4.0",
    "firebase": "12.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.27.0",
    "wrangler": "^4.0.0"
  }
}
